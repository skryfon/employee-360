  },
  "dependencies": {
    "@tanstack/react-query": "^5.103.1",
    "axios": "^1.20.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axios-mock-adapter": "^2.1.0",
    "jsdom": "^30.1.0",
    "orval": "^8.33.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  }
}
