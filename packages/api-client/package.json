{
  "name": "@employee360/api-client",
  "private": true,
  "version": "0.0.0",
  "description": "Shared Axios API client (JWT/X-Tenant-ID interceptors) and Orval-generated types/hooks for Employee360 frontend apps.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "generate": "orval --config orval.config.ts",
