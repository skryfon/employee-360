# ==============================================================================
# Employee360 Backend Configuration Example
# ==============================================================================

server:
  port: "8080"
  host: "0.0.0.0"
  read_timeout: 10s
  write_timeout: 10s
  shutdown_timeout: 10s

database:
  host: "localhost"
  port: "5432"
  user: "postgres"
  password: "postgres"
  dbname: "employee360"
  sslmode: "disable"
  max_open_conns: 25
  max_idle_conns: 5
  conn_max_lifetime: 15m
  conn_timeout: 5s

jwt:
  secret: "change-me-in-production-secret-key-360"
  access_expiry: 15m
  refresh_expiry: 168h

app:
  environment: "development"
  log_level: "debug"

cors:
  allowed_origins:
    - "*"

smtp:
  host: "smtp.resend.com"
  port: 465
  username: "resend"
  password: "<RESEND_API_KEY>"
  from: "Employee360 <no-reply@example.com>"
  use_tls: true


# Read only by cmd/bootstrap. Prefer the env vars BOOTSTRAP_SUPER_ADMIN_EMAIL /
# BOOTSTRAP_SUPER_ADMIN_PASSWORD over committing credentials to a file.
bootstrap:
  system_tenant_name: "System"
  super_admin_email: ""
  super_admin_password: ""
