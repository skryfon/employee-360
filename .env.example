# ==============================================================================
# Employee360 root environment — used by:
#   - docker-compose.yml (Postgres container: DATABASE_USER/PASSWORD/NAME/PORT)
#   - backend/config/config.go (Viper env bindings; picked up via ../.env when
#     the backend runs from backend/, e.g. `make dev-api`)
#   - clients/admin/vite.config.ts, clients/employee/vite.config.ts
#     (ADMIN_PORT/EMPLOYEE_PORT — read from the actual shell env, not
#     auto-loaded from this file; export or use a tool like `dotenv-cli`
#     if you want this file itself to drive them)
# Copy to .env (gitignored) and adjust for local development.
# ==============================================================================

# --- Server ---
SERVER_PORT=8080
SERVER_HOST=0.0.0.0

# --- Frontend dev server ports (clients/admin, clients/employee) ---
ADMIN_PORT=5173
EMPLOYEE_PORT=5174

# --- Database (matches docker-compose.yml defaults) ---
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=employee360
DATABASE_SSLMODE=disable

# --- JWT ---
JWT_SECRET=employee360-super-secret-key-change-in-production

# --- App ---
APP_ENV=development
LOG_LEVEL=debug

# --- CORS (comma-separated origins) ---
CORS_ALLOWED_ORIGINS=*
