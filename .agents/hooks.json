{
  "migration-safety": {
    "PreToolUse": [
      {
        "matcher": "write_to_file|replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "bash .agents/hooks/check-migration.sh",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "bash .agents/hooks/tenant-scope-reminder.sh",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "code-quality-checks": {
    "PostToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|run_command",
        "hooks": [
          {
            "type": "command",
            "command": "bash .agents/hooks/backend-check.sh",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "bash .agents/hooks/frontend-check.sh",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
